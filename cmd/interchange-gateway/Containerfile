# interchange-gateway container — tiny static Go binary on scratch.
# Build from the interchange repo root:
#   podman build -f cmd/interchange-gateway/Containerfile -t interchange-gateway:dev .
#   podman save interchange-gateway:dev | sudo k3s ctr images import -
#
# Runtime config via env (see cmd/interchange-gateway/main.go):
#   INTERCHANGE_ADDR, INTERCHANGE_ROUTES, INTERCHANGE_HERALD_ISSUER, INTERCHANGE_AUTH_BYPASS
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26 AS build
ARG TARGETARCH
ENV GOTOOLCHAIN=auto
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Cross-compile to the target arch (pure Go, CGO disabled) — fast, no emulation.
RUN CGO_ENABLED=0 GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/interchange-gateway ./cmd/interchange-gateway

FROM scratch
# CA certs so heraldauth can fetch JWKS over HTTPS from a real herald issuer.
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/interchange-gateway /interchange-gateway
EXPOSE 8080
ENTRYPOINT ["/interchange-gateway"]
